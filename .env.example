# Environment variables example for Masar / Jira-Nexus
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# Node.js API Service
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Set a strong 64+ char random secret in production:
SESSION_SECRET=your_strong_random_session_secret_here
# Optional Error Monitoring DSN:
MIRAT_DSN=

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/masar

# .NET Backend Service
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=masar;Username=postgres;Password=your_db_password

# Web Frontend
VITE_API_URL=http://localhost:3000
