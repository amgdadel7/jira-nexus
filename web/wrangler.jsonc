{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jira-nexus",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jira-nexus-db",
      "database_id": "5be4ee29-7d05-4b7f-8882-2fad4df45a8f"
    }
  ]
}
