{
  "name": "masar-server",
  "version": "1.0.0",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:legacy": "node index.js",
    "dev": "node --watch src/main.js",
    "health": "node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2)))\"",
    "db": "node src/cli/db.js",
    "db:migrate-data": "node src/cli/migrate.js",
    "seed": "node src/cli/db.js seed --force",
    "test": "node --test --test-concurrency=1 test/api.test.js test/phase6.test.js test/phase7.test.js test/security.test.js test/smoke.test.js test/migration.test.js test/operations.test.js",
    "test:smoke": "node --test test/smoke.test.js",
    "test:security": "node --test test/security.test.js",
    "test:migration": "node --test test/migration.test.js",
    "test:operations": "node --test test/operations.test.js",
    "backup": "node src/cli/backup.js",
    "check:secrets": "node ../scripts/check-secrets.js",
    "test:pg": "TEST_DATABASE_URL=postgres://masar:masar@localhost:5432/masar_test node --test --test-concurrency=1 test/api.test.js test/security.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Masar API \u2014 Clean Architecture on PostgreSQL",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
